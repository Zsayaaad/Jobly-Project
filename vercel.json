{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "source": "/api/v1/(.*)",
      "destination": "server.js"
    },
    {
      "source": "/(.*)",
      "destination": "/client/dist/$1",
      "check": true
    },
    {
      "source": "/(.*)",
      "destination": "server.js"
    }
  ]
}
